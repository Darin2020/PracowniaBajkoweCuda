# Local development values for docker compose. Copy this file to `.env` (git-ignored) and adjust.
# Never put real secrets here: this file is committed.

# --- SQL Server (docker compose) -------------------------------------------
# Must satisfy the SQL Server password policy (8+ chars, upper + lower + digit/symbol).
# Choose your own value for local use.
MSSQL_SA_PASSWORD=
SQL_PORT=1433

# --- Azurite (Blob Storage emulator) ---------------------------------------
AZURITE_BLOB_PORT=10000
AZURITE_QUEUE_PORT=10001

# --- Mailpit (local SMTP server + web UI) ----------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---------------------------------------------------------------------------
# Application settings (docs/PLAN.md §14). The API does not read them yet;
# they are documented here as each phase starts using them. For `dotnet run`
# set secrets with `dotnet user-secrets`, not in this file.
# ---------------------------------------------------------------------------
# PublicBaseUrl=http://localhost:4200
# ConnectionStrings__Sql=Server=localhost,1433;Database=BajkoweCuda;User Id=sa;Password=<MSSQL_SA_PASSWORD>;TrustServerCertificate=True
# Storage__ConnectionString=UseDevelopmentStorage=true
# Email__Provider=Smtp
# Email__Smtp__Host=localhost
# Email__Smtp__Port=1025
