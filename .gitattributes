# Normalize line endings: LF in the repository and in the working copy (Prettier and Linux containers expect LF).
* text=auto eol=lf

# Files that must always be LF (run inside Linux containers / CI).
*.sh            text eol=lf
Dockerfile      text eol=lf
*.dockerfile    text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.bicep         text eol=lf
*.bicepparam    text eol=lf

# Windows-only scripts.
*.cmd           text eol=crlf
*.bat           text eol=crlf
*.ps1           text eol=crlf

# Source.
*.cs            text diff=csharp
*.csproj        text
*.props         text
*.targets       text
*.sln           text eol=crlf
*.ts            text
*.html          text diff=html
*.scss          text diff=css
*.json          text
*.md            text diff=markdown
*.xlf           text
*.resx          text

# Generated lock file: keep it out of diffs and merges.
package-lock.json text -diff

# Binary assets.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.avif  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.pdf   binary
